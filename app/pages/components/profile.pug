-
  var profileFields = [
    { label: "Страна", value: "Москва, Россия", icon: "globe" },
    { label: "Телефон", value: "+7 (499) 123-45-67", icon: "telephone" },
    { label: "Email", value: "nikita.m@hexlet.io", icon: "envelope" },
    { label: "Twitter", value: "@n__mikhaylov", icon: "people" }
  ]

mixin profile-field(label, value, icon)
  li.px-4.py-3.border-top.d-flex.justify-content-between.align-items-center.gap-3
    div
      p.small.text-muted.mb-1= label
      p.mb-0= value
    svg.text-muted.flex-shrink-0(width="20" height="20")
      use(xlink:href=`assets/icons/sprite.svg#${icon}`)

.contacts-container.flex-grow-1.overflow-hidden
  .contacts-content.overflow-y-auto.h-100
    .d-flex.flex-column.align-items-center.text-center.mt-5.px-4.pb-4
      img.rounded-circle.mb-3(src="assets/images/avatar_1.jpg" width="100" height="100" alt="Кодовёнок Хекслетович")
      h6.fw-bold.mb-2 Кодовёнок Хекслетович
      p.small.text-muted.mb-0 Милый и скромный помощник начинающих разработчиков. Люблю JavaScript
    ul.list-unstyled.mb-0.pb-5
      each field in profileFields
        +profile-field(field.label, field.value, field.icon)
