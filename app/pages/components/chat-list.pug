-
  var chatList = [
    {
      name: "Вениамин Редакторович",
      time: "11:45",
      message: "o_O",
      avatar: "assets/images/avatar_4.jpg"
    },
    {
      name: "Джедай Падаванов",
      time: "10:12",
      message: "Привет, скоро третий проект? Уже скоро…",
      avatar: "assets/images/avatar_2.jpg"
    },
    {
      name: "Алексей Примадонин",
      time: "08:53",
      message: "Тесты упали >_<",
      avatar: "assets/images/avatar_3.jpg"
    }
  ]

mixin chat-list-item(name, time, message, avatar)
  a.contact-card.d-flex.gap-3.align-items-center.shadow-sm.p-4.mb-3.text-decoration-none.text-dark(href="chat.html")
    img.rounded-circle.flex-shrink-0(src=avatar height="50" width="50" alt=name)
    .flex-grow-1.overflow-hidden
      .d-flex.justify-content-between.align-items-center.gap-2
        h6.mb-0.fw-bold.text-truncate= name
        span.small.flex-shrink-0= time
      p.small.mb-0.text-truncate= message

.contacts-container.flex-grow-1.overflow-hidden
  .contacts-content.overflow-y-auto.h-100
    .mt-5.px-4.pb-5
      each item in chatList
        +chat-list-item(item.name, item.time, item.message, item.avatar)
